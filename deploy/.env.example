# =====================================================================
# Configuration du serveur de production — copier en deploy/.env
# Ce fichier contient des secrets : ne JAMAIS le committer ni l'envoyer
# par messagerie. Conserver une copie dans un coffre-fort de mots de passe.
# =====================================================================

# --- Serveur ------------------------------------------------------------
# Nom de domaine principal (sans https://, sans « www »)
DOMAIN=exemple-a-remplacer.com
# Adresse qui recevra les alertes d'expiration du certificat HTTPS
ACME_EMAIL=
# Version de l'image (ex. date ou numéro de version) — sert au retour arrière
APP_VERSION=latest

# Mot de passe de la base (lettres et chiffres uniquement, 32 caractères).
# Générer avec : openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Application ----------------------------------------------------------
# demo tant que les informations ne sont pas validées ; production ensuite.
APP_MODE=demo
# Générer avec : openssl rand -base64 48
APP_SECRET=
UPLOAD_MAX_MB=8

# --- Courriels (facultatif) ------------------------------------------------
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
NOTIFY_EMAIL=

# --- Paiement ----------------------------------------------------------------
# none tant qu'aucun prestataire n'est contractualisé.
PAYMENT_PROVIDER=none
DEMO_PAYMENT_WEBHOOK_SECRET=
