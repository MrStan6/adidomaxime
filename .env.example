# =====================================================================
# Variables d'environnement — copier en .env et compléter.
# Ne JAMAIS committer le fichier .env : il contient des secrets.
# =====================================================================

# --- Mode de fonctionnement -------------------------------------------
# demo        : bandeau « démonstration » visible, données de démo affichées,
#               prestataire de paiement de démonstration autorisé.
# production  : données de démo masquées, paiement de démo REFUSÉ.
APP_MODE=demo

# URL publique du site (sans barre finale). Utilisée pour le SEO,
# le sitemap et les liens dans les courriels.
SITE_URL=http://localhost:3000

# --- Base de données PostgreSQL ---------------------------------------
DATABASE_URL=postgres://hotel:hotel_dev@localhost:5432/hotel_dev
# Chiffrement de la connexion : false | true (vérifie le certificat, recommandé)
# | no-verify (chiffré sans vérifier l'autorité — à éviter en production).
DATABASE_SSL=false
# Certificat racine PEM de l'hébergeur de base, si non reconnu publiquement
# (ex. Supabase : « Download certificate » dans Database Settings).
DATABASE_SSL_CA=
# Connexions simultanées par instance (réduire à 2-3 sur Vercel/serverless).
DATABASE_POOL_MAX=10

# --- Sécurité -----------------------------------------------------------
# Chaîne aléatoire d'au moins 32 caractères. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=remplacer-par-une-chaine-aleatoire-longue-et-secrete
# true uniquement si l'application est derrière un proxy de confiance
# (Nginx, Caddy, Vercel…) qui transmet l'en-tête X-Forwarded-For.
TRUST_PROXY=false

# --- Fichiers envoyés (photos) ----------------------------------------
# Dossier persistant hors du code source (sauvegardé avec la base).
UPLOAD_DIR=./storage/uploads
# Taille maximale d'une image en Mo
UPLOAD_MAX_MB=8

# --- Courriels ----------------------------------------------------------
# none : aucun envoi (les demandes restent consultables dans l'administration)
# smtp : envoi via un serveur SMTP (Brevo, Mailjet, OVH, Gmail Workspace…)
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expédition (doit être autorisée par le serveur SMTP)
EMAIL_FROM=
# Adresse interne qui reçoit les alertes de nouvelles demandes
NOTIFY_EMAIL=

# --- Paiement en ligne --------------------------------------------------
# none : aucun paiement en ligne (valeur à conserver tant qu'aucun
#        prestataire n'est contractualisé).
# demo : prestataire FICTIF pour tester le parcours ; refusé si APP_MODE=production.
PAYMENT_PROVIDER=none
# Secret de signature des notifications du prestataire de démonstration.
DEMO_PAYMENT_WEBHOOK_SECRET=
